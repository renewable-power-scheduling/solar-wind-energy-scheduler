{
  "site_id": "CME",
  "protocol": "sftp",
  "plant_capacity_mw": 5.0,
  "operational_capacity_mw": 4.0,
  "forecast_capacity_mw": 5.0,
  "enforce_operational_cap": true,
  "penalty_band_pct": 0.1,

  "connection": {
    "host": "transfer.enercast.de",
    "port": 22,
    "username": "vedanjay",
    "password_env": "SITE_PASSWORD"
  },

  "paths": {
    "remote_forecasts": "/forecasts"
  },

  "file_patterns": {
    "forecast_regex": "^vedanjay_CME_PV_(Dayahead|Intraday)_(\\d{4}-\\d{2}-\\d{2})-(\\d{2})-(\\d{2})\\+0530\\.csv$"
  },

  "enercast": {
    "owner": "vedanjay",
    "site_tag": "CME_PV",
    "forecast_column": "CME",
    "date_row_labels": [
      "DATE:",
      "FOR DATE:"
    ],
    "date_formats": [
      "%Y-%m-%d",
      "%Y%m%d"
    ]
  },

  "weather": {
    "latitude": 18.597833,
    "longitude": 73.858361,
    "model": "gfs_seamless",
    "timezone": "Asia/Kolkata",
    "current_vars": [
      "temperature_2m",
      "wind_speed_10m",
      "cloud_cover"
    ],
    "minutely_vars": [
      "temperature_2m",
      "wind_speed_10m",
      "diffuse_radiation",
      "global_tilted_irradiance"
    ]
  },

  "runtime": {
    "run_continuous": true,
    "retry_seconds_on_error": 60,
    "timezone": "Asia/Kolkata"
  },

  "scheduling_parameters": {
    "start_block": 1,
    "gen_end_block": 96,
    "abrupt_window_blocks": 2,
    "max_abrupt_adj": 0.1,
    "weight_intraday": 0.85,
    "irr_full_trust": 0.4,
    "irr_zero_trust": 0.1,
    "low_gti_irr_ratio_threshold": 0.15,
    "low_gti_damp_factor": 0.85,
    "trend_eps": 1.5,
    "smooth_alpha": 0.3,
    "start_threshold": 0.08,
    "acceptance_mw": 0.3,
    "ramp_cap_factor": 1.3,
    "ramp_ramp_mult": 1.2,
    "ramp_enable_irr_ratio": 0.2
  },

  "ddb_plant_id": "CME",

  "whatsapp_meter": {
    "enabled": true,
    "table_name": "whatsapp_meter_data",
    "msg_lookback_hours": 6,
    "max_staleness_min": 45,
    "max_future_sec": 120,
    "time_snap_tolerance_sec": 120,
    "dup_ttl_hours": 24,
    "min_mw": -0.2,
    "max_mw_factor": 1.2,
    "regen_min_deviation_mw": 0.2,
    "regen_cooldown_blocks": 1,
    "weight_intraday_base": 0.92,
    "weight_whatsapp_base": 0.08,
    "weight_whatsapp_max": 0.35,
    "whatsapp_correction_horizon_blocks": 4,
    "recency_tau_min": 30.0,
    "forecast_dynamic_start_frac": 0.01,
    "whatsapp_dynamic_start_mw": 0.1,
    "site_id_attr": "site_id",
    "event_ts_attr": "timestamp",
    "msg_id_attr": "timestamp",
    "actual_mw_attr": "actual_mw",
    "confidence_attr": "confidence",
    "power_unit": "auto"
  },

  "adjustment_overrides": {
    "base_adjustment_thresholds": [6, 4, 2],
    "base_adjustment_values": [5, 3, 2, 0],

    "irradiance_state_thresholds": {
      "STABLE_CLEAR": 0.78,
      "VARIABLE_CLEAR": 0.5,
      "CLOUD_TRANSIENT": 0.25
    },

    "irradiance_multiplier": {
      "STABLE_CLEAR": 0.82,
      "VARIABLE_CLEAR": 0.6,
      "CLOUD_TRANSIENT": 0.32,
      "OVERCAST": 0.22
    },

    "temp_multiplier_thresholds": [40, 35, 25],
    "temp_multiplier_values": [0.75, 0.78, 0.92, 0.96],

    "wind_multiplier_thresholds": [1.5, 3, 5],
    "wind_multiplier_values": [0.76, 0.86, 0.91, 0.95]
  }
}
