  "paths": {
    "remote_forecasts": "/forecasts",
    "remote_metered": "/incoming/powerdata_realtime/SIRMOUR"
  },

  "file_patterns": {
    "intraday_filename_regex": "^vedanjay_SIRMOUR_PV_Intraday_{current_date}-(?P<hh>\\d{2})-(?P<mm>\\d{2})\\+0530\\.csv$",
    "day_ahead_filename_regex": "^vedanjay_SIRMOUR_PV_Dayahead_{current_date}-(?P<hh>\\d{2})-(?P<mm>\\d{2})\\+0530\\.csv$",
    "metered_template": "{date_yyyy_mm_dd}_SOLAR_INV.csv"
  },

  "enercast": {
    "owner": "vedanjay",
    "site_tag": "SIRMOUR_PV",
    "forecast_column": "SIRMOUR",
    "date_row_labels": ["DATE:", "FOR DATE:"],
    "date_formats": ["%Y-%m-%d", "%Y%m%d"]
  },

  "weather": {
    "latitude": 24.56253056,
    "longitude": 75.09140278,
    "model": "gfs_seamless",
    "timezone": "Asia/Kolkata",
    "current_vars": ["temperature_2m", "wind_speed_10m", "cloud_cover"],
    "minutely_vars": [
      "temperature_2m",
      "wind_speed_10m",
      "diffuse_radiation",
      "global_tilted_irradiance"
    ]
  },

  "runtime": {
    "run_continuous": true,
    "retry_seconds_on_error": 60,
    "timezone": "Asia/Kolkata"
  },

  "metered": {
    "timestamp_col": "Timestamp",
    "power_col": "Active Power-avg MFM-OUT(Meter Power) (kW)",
    "filename_mode": "yyyy_mm_dd_solar_inv"
  },

