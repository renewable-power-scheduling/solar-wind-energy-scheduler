    "first_mandatory_revision": 1,
    "mandatory_revision_no": 1,
    "first_arrival_block": 28,
    "first_generation_block": 28,
    "mandatory_generation_block": 28
  },
  "protocol": "ftp",
  "plant_capacity_mw": 15.0,
  "capacity": {
    "dc_capacity_mw": 15.0,
    "ac_capacity_mw": 15.0,
    "dc_ac_ratio": 1.0,
    "plant_capacity_field_meaning": "DC_AS_AC_DEFAULT"
  },
  "penalty_band_pct": 0.15,

  "connection": {
    "host": "ftp.enercast.de",
    "port": 21,
    "tls": true,
    "epsv": false
  },

  "paths": {
    "remote_forecasts": "/forecasts",
    "remote_metered": "/incoming/powerdata_realtime"
  },

  "file_patterns": {
    "intraday_filename_regex": "^kasipet_{current_date}_Intraday_REMC_r(?P<rev>\\d+)\\.csv$",
    "day_ahead_filename_regex": "^kasipet_{next_date}_(?:dayahead_DA(?P<rev>\\d+)|DA(?P<rev_alt>\\d+)_DA\\d+)\\.csv$",
    "week_ahead_filename_regex": "^kasipet_{next_date}_weekahead_WA\\.csv$",
    "metered_template": "kasipet_{date_yyyymmdd}.csv"
  },

  "enercast": {
    "owner": "vedanjay",
    "site_tag": "KASIPET",
    "forecast_column": "SCH_MW",
    "date_row_labels": [
      "DATE:",
      "FOR DATE:"
    ],
    "date_formats": [
      "%Y-%m-%d",
      "%Y%m%d"
    ]
  },

  "weather": {
    "latitude": 19.03943918,
    "longitude": 79.43691745,
    "model": "gfs_seamless",
    "timezone": "Asia/Kolkata",
    "current_vars": [
      "temperature_2m",
      "wind_speed_10m",
      "cloud_cover"
    ],
    "minutely_vars": [
      "temperature_2m",
      "wind_speed_10m",
      "diffuse_radiation",
      "global_tilted_irradiance"
    ]
  },

  "runtime": {
    "run_continuous": true,
    "retry_seconds_on_error": 60,
    "timezone": "Asia/Kolkata"
  },

  "metered": {
    "timestamp_col": "Timestamp",
    "power_col": "Active Power-Avg MFM-OUT (KW)",
    "filename_mode": "yyyy_mm_dd_solar_inv"
  },

  "scheduling_parameters": {
    "start_block": 1,
    "gen_end_block": 96,
    "abrupt_window_blocks": 3,
    "max_abrupt_adj": 0.1,
    "weight_meter": 0.02,
    "weight_intraday": 0.98,
    "irr_full_trust": 0.4,
    "irr_zero_trust": 0.1,
    "low_gti_irr_ratio_threshold": 0.15,
    "low_gti_damp_factor": 0.85,
    "trend_eps": 1.5,
    "smooth_alpha": 0.3,
    "ramp_cap_factor": 1.3,
    "ramp_ramp_mult": 1.2,
    "ramp_enable_irr_ratio": 0.2
  },

  "ddb_plant_id": "Kasipet",
  "lambda_architecture": {
    "fetcher_lambda_name": "KASIPET-fetcher",
    "scheduler_lambda_name": "KASIPET-scheduler",
    "fetcher_cron_profile": "normal",
    "fetcher_cron_expression": "cron(3,18,33,48 * * * ? *)"
  },

  "adjustment_overrides": {
