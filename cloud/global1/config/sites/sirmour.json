{
  "site_id": "SIRMOUR",
  "protocol": "sftp",
  "plant_capacity_mw": 5.1,
  "penalty_band_pct": 0.1,

  "connection": {
    "host": "transfer.enercast.de",
    "port": 22,
    "username": "vedanjay",
    "password_env": "SITE_PASSWORD"
  },

  "paths": {
    "remote_forecasts": "/forecasts",
    "remote_metered": "/incoming/powerdata_realtime/SIRMOUR"
  },

  "file_patterns": {
    "intraday_filename_regex": "^vedanjay_SIRMOUR_PV_Intraday_{current_date}-(?P<hh>\\d{2})-(?P<mm>\\d{2})\\+0530\\.csv$",
    "day_ahead_filename_regex": "^vedanjay_SIRMOUR_PV_Dayahead_{current_date}-(?P<hh>\\d{2})-(?P<mm>\\d{2})\\+0530\\.csv$",
    "metered_template": "{date_yyyy_mm_dd}_SOLAR_INV.csv"
  },

  "enercast": {
    "owner": "vedanjay",
    "site_tag": "SIRMOUR_PV",
    "forecast_column": "SIRMOUR",
    "date_row_labels": [
      "DATE:",
      "FOR DATE:"
    ],
    "date_formats": [
      "%Y-%m-%d",
      "%Y%m%d"
    ]
  },

  "weather": {
    "latitude": 24.56253056,
    "longitude": 75.09140278,
    "model": "gfs_seamless",
    "timezone": "Asia/Kolkata",
    "current_vars": [
      "temperature_2m",
      "wind_speed_10m",
      "cloud_cover"
    ],
    "minutely_vars": [
      "temperature_2m",
      "wind_speed_10m",
      "diffuse_radiation",
      "global_tilted_irradiance"
    ]
  },

  "runtime": {
    "run_continuous": true,
    "retry_seconds_on_error": 60,
    "timezone": "Asia/Kolkata"
  },

  "metered": {
    "timestamp_col": "Timestamp",
    "power_col": "Active Power-avg MFM-OUT(Meter Power) (kW)",
    "filename_mode": "yyyy_mm_dd_solar_inv"
  },

  "scheduling_parameters": {
    "start_block": 1,
    "gen_end_block": 96,
    "abrupt_window_blocks": 2,
    "max_abrupt_adj": 0.1,
    "weight_meter": 0.02,
    "weight_intraday": 0.98,
    "irr_full_trust": 0.4,
    "irr_zero_trust": 0.1,
    "low_gti_irr_ratio_threshold": 0.15,
    "low_gti_damp_factor": 0.85,
    "trend_eps": 1.5,
    "smooth_alpha": 0.3,
    "start_threshold": 0.08,
    "acceptance_mw": 0.3,
    "ramp_cap_factor": 1.3,
    "ramp_ramp_mult": 1.2,
    "ramp_enable_irr_ratio": 0.2
  },

  "ddb_plant_id": "Sirmour",
  "adjustment_overrides": {
    "base_adjustment_thresholds": [6, 4, 2],
    "base_adjustment_values": [7.5, 5.0, 2.5, 0.0],

    "irradiance_state_thresholds": {
      "STABLE_CLEAR": 0.75,
      "VARIABLE_CLEAR": 0.45,
      "CLOUD_TRANSIENT": 0.20
    },

    "irradiance_multiplier": {
      "STABLE_CLEAR": 1.15,
      "VARIABLE_CLEAR": 1.00,
      "CLOUD_TRANSIENT": 0.70,
      "OVERCAST": 0.55
    },

    "temp_multiplier_thresholds": [40, 35, 25],
    "temp_multiplier_values": [0.95, 0.97, 1.00, 1.03],

    "wind_multiplier_thresholds": [1.5, 3, 5],
    "wind_multiplier_values": [0.95, 1.00, 1.03, 1.05]
  }
}
