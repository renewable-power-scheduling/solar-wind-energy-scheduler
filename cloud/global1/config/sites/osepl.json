{
  "site_id": "OSEPL",
  "protocol": "ftp",
  "plant_capacity_mw": 20.0,
  "penalty_band_pct": 0.10,
  "connection": {
    "host": "ftp.enercast.de",
    "port": 21,
    "tls": true,
    "epsv": false
  },
  "paths": {
    "remote_forecasts": "/forecasts",
    "remote_metered": "/incoming/powerdata_realtime"
  },
  "file_patterns": {
    "intraday_filename_regex": "^essel_OSEPL_intraday_{current_date}-(?P<hh>\\d{2})-(?P<mm>\\d{2})\\+\\d{4}\\.csv$",
    "day_ahead_filename_regex": "^essel_OSEPL_dayahead_{current_date}-(?P<hh>\\d{2})-(?P<mm>\\d{2})\\+\\d{4}\\.csv$",
    "metered_template": "ESSEL_{date_yyyy_mm_dd}_00_00_00.csv"
  },
  "enercast": {
    "owner": "vedanjay",
    "site_tag": "OSEPL",
    "forecast_column": "OSEPL",
    "date_row_labels": ["DATE:", "FOR DATE:"],
    "date_formats": ["%Y-%m-%d", "%Y%m%d"]
  },
  "weather": {
    "latitude": 17.9068,
    "longitude": 76.3229,
    "model": "gfs_seamless",
    "timezone": "Asia/Kolkata",
    "current_vars": ["temperature_2m", "wind_speed_10m", "cloud_cover"],
    "minutely_vars": ["temperature_2m", "wind_speed_10m", "diffuse_radiation", "global_tilted_irradiance"]
  },
  "runtime": {
    "run_continuous": true,
    "retry_seconds_on_error": 60,
    "timezone": "Asia/Kolkata"
  },
  "metered": {
    "timestamp_col": "TIME",
    "power_col": "MW",
    "filename_mode": "ESSEL_{date_yyyy_mm_dd}_00_00_00.csv",
    "delimiter": ";",
    "power_unit": "MW",
    "round_to_15": true
