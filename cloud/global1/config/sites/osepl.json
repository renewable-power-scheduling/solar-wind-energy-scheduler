    "weight_intraday": 0.90,
    "irr_full_trust": 0.40,
    "irr_zero_trust": 0.10,
    "low_gti_irr_ratio_threshold": 0.15,
    "low_gti_damp_factor": 0.85,
    "trend_eps": 1.5,
    "smooth_alpha": 0.30,
    "start_threshold": 0.08,
    "acceptance_mw": 0.25,
    "ramp_cap_factor": 1.30,
    "ramp_ramp_mult": 1.20,
    "ramp_enable_irr_ratio": 0.20,
    "receivable_bias_enable": true,
    "receivable_over_min_pct": 2.0,
    "receivable_over_target_pct": 5.0,
    "receivable_over_max_pct": 9.0,
    "receivable_min_base_mw": 0.3,
