{
  "site_id": "KOTHAGUDEM",
  "protocol": "ftp",
  "plant_capacity_mw": 37.0,
  "penalty_band_pct": 0.15,

  "connection": {
    "host": "ftp.enercast.de",
    "port": 21,
    "tls": true,
    "epsv": false
  },

  "paths": {
    "remote_forecasts": "/forecasts",
    "remote_metered": "/incoming/powerdata_realtime"
  },

  "file_patterns": {
    "intraday_filename_regex": "^kothagudem_{current_date}_Intraday_REMC_r(?P<rev>\\d+)\\.csv$",
    "day_ahead_filename_regex": "^kothagudem_{next_date}_dayahead_DA(?P<rev>\\d+)\\.csv$",
    "metered_template": "kothagudem_{date_yyyymmdd}.csv"
  },

  "enercast": {
    "owner": "vedanjay",
    "site_tag": "KOTHAGUDEM",
    "forecast_column": "SCH_MW",
    "date_row_labels": [
      "DATE:",
      "FOR DATE:"
    ],
    "date_formats": [
      "%Y-%m-%d",
      "%Y%m%d"
    ]
  },

  "weather": {
    "latitude": 17.52500925,
    "longitude": 80.64616743,
    "model": "gfs_seamless",
    "timezone": "Asia/Kolkata",
    "current_vars": [
      "temperature_2m",
      "wind_speed_10m",
      "cloud_cover"
    ],
    "minutely_vars": [
      "temperature_2m",
      "wind_speed_10m",
      "diffuse_radiation",
      "global_tilted_irradiance"
    ]
  },

  "runtime": {
    "run_continuous": true,
    "retry_seconds_on_error": 60,
    "timezone": "Asia/Kolkata"
  },

  "metered": {
    "timestamp_col": "Timestamp",
    "power_col": "Active Power-avg MFM-OUT(Meter Power) (kW)",
    "filename_mode": "yyyy_mm_dd_solar_inv"
  },

  "scheduling_parameters": {
    "start_block": 1,
    "gen_end_block": 96,
    "abrupt_window_blocks": 3,
    "max_abrupt_adj": 0.1,
    "weight_meter": 0.02,
    "weight_intraday": 0.98,
    "irr_full_trust": 0.4,
    "irr_zero_trust": 0.1,
    "low_gti_irr_ratio_threshold": 0.15,
    "low_gti_damp_factor": 0.85,
    "trend_eps": 1.5,
    "smooth_alpha": 0.3,
    "start_threshold": 0.08,
    "acceptance_mw": 0.08,
    "ramp_cap_factor": 1.3,
    "ramp_ramp_mult": 1.2,
    "ramp_enable_irr_ratio": 0.2
  },

  "ddb_plant_id": "Kothagudem",

  "adjustment_overrides": {
    "base_adjustment_thresholds": [6, 4, 2],
    "base_adjustment_values": [3, 2, 1, 0],

    "irradiance_state_thresholds": {
      "STABLE_CLEAR": 0.76,
      "VARIABLE_CLEAR": 0.48,
      "CLOUD_TRANSIENT": 0.22
    },

    "irradiance_multiplier": {
      "STABLE_CLEAR": 0.83,
      "VARIABLE_CLEAR": 0.62,
      "CLOUD_TRANSIENT": 0.33,
      "OVERCAST": 0.23
    },

    "temp_multiplier_thresholds": [38, 33, 25],
    "temp_multiplier_values": [0.72, 0.8, 0.9, 0.96],

    "wind_multiplier_thresholds": [1, 2.5, 4.5],
    "wind_multiplier_values": [0.72, 0.82, 0.88, 0.93]
  }
}
